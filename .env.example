# ==========================================
# ChatConnect Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/chatconnect
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/chatconnect

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=super_secret_jwt_key_chatconnect_2025_prod_safe

# JWT Token Expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRE=7d

# Frontend Client URL (For CORS and Socket.IO origin authorization)
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Configuration for Media Storage
# If left empty, ChatConnect automatically stores media securely in local server/uploads directory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Max Upload File Size in Bytes (default: 50MB)
MAX_FILE_SIZE=52428800
