PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/chatconnect
JWT_SECRET=super_secret_jwt_key_chatconnect_2025_prod_safe
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary credentials (leave empty to use local storage in server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Real Mobile SMS OTP Gateways
# Option 1: Twilio (Global SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 2: Fast2SMS (India SMS)
FAST2SMS_API_KEY=

MAX_FILE_SIZE=52428800
