{
  "name": "chatconnect",
  "version": "1.0.0",
  "description": "Production-ready Real-Time WhatsApp-Style Chat Application",
  "private": true,
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "npm --prefix server run seed",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "chat",
    "whatsapp",
    "socketio",
    "react",
    "nodejs",
    "realtime",
    "chatconnect"
  ],
  "author": "ChatConnect Team",
  "license": "MIT"
}