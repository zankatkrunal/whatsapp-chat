{
  "name": "chatconnect",
  "version": "1.0.0",
  "description": "Production-ready Real-Time WhatsApp-Style Chat Application",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "npm --prefix server run seed",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.4",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "chat",
    "whatsapp",
    "socketio",
    "react",
    "nodejs",
    "realtime",
    "chatconnect"
  ],
  "author": "ChatConnect Team",
  "license": "MIT"
}